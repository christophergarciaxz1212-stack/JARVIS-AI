# JARVIS AI - Environment Variables
# Copy this file to .env.local and fill in your API keys
# JARVIS opera só com provedores GRATUITOS (os pagos — OpenAI, Anthropic, DeepSeek, xAI — foram removidos).
# At least ONE of the following free providers is enough to get started.

# Google Gemini (FREE tier available) — recommended for beginners
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (FREE models available + aggregator for 100+ models)
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq (FREE tier - ultra fast inference)
# Get at: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras (FREE tier - fast inference)
# Get at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# SambaNova (FREE tier)
# Get at: https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# NVIDIA NIM (FREE credits)
# Get at: https://build.nvidia.com
NVIDIA_API_KEY=

# GitHub token (optional) - raises the Skills store's GitHub search limits.
# Get at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Hugging Face (FREE tier)
# Get at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Brave Search (for web search capability)
# Get at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Ollama (local - no key needed if running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Pontes gratuitas na mesma máquina (opcional — só se os binários não estiverem num local padrão)
# AGY_PATH=C:\Users\voce\.gemini\bin\agy.exe
# OPENCODE_CLI=C:\Users\voce\AppData\Local\Programs\ai.opencode.desktop\resources\opencode-cli.exe

# Atualização automática (opcional): verifica se há versão mais nova em GitHub Releases
# JARVIS_UPDATE_REPO=dono/repositorio

# LM Studio (local - no key needed)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Provedor personalizado (OpenAI-compatible, qualquer endpoint: LiteLLM gateway, vLLM, LocalAI…)
# Exemplo com LiteLLM: CUSTOM_AI_BASE_URL=http://localhost:4000/v1 · CUSTOM_AI_MODEL=gpt-4o-mini
# Sem as duas primeiras variáveis, este provedor nem aparece.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_NAME=Provedor personalizado

# Anthropic / Claude (PAGO — desativado por padrão; o JARVIS opera gratuito por padrão)
# Para reativar: ANTHROPIC_API_KEY=… e JARVIS_ALLOW_PAID=1
# ANTHROPIC_API_KEY=
# JARVIS_ALLOW_PAID=1

# OpenWA — gateway WhatsApp não-oficial (QR code) para o seu número pessoal
# A chave é gerada pelo próprio OpenWA no primeiro boot; o JARVIS adota ela automaticamente
# quando você usa "Instalar OpenWA" no WhatsApp Center. Preencha só para apontar para um
# OpenWA externo (servidor/VPS/Docker) — ou pela UI Chaves de API.
# OPENWA_API_KEY=
# URL pública do próprio JARVIS que o OpenWA usa para entregar webhooks (normalmente não mexa)
# OPENWA_WEBHOOK_URL=http://127.0.0.1:3001/api/openwa/webhook
