      "port": 3003,
      "url": "http://127.0.0.1:3003"
    },
    {
      "name": "jarvis-dev-3002",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3002", "-H", "127.0.0.1"],
      "port": 3002,
      "url": "http://127.0.0.1:3002"
    },
    {
      "name": "jarvis-dev-isolated-3004",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:JARVIS_DIST_DIR='.next-claude'; npx.cmd next dev -p 3004 -H 127.0.0.1"],
