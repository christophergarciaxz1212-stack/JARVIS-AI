{
  "name": "jarvis-ai",
  "version": "1.2.2",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "zod": "^4.6.7"
  },
  "main": "electron/main.js",
  "build:installer": "npm run build && npx electron-builder --win --x64",
  "scripts": {
    "app": "electron --no-sandbox .",
    "app:dev": "electron --no-sandbox . --dev",
    "dev": "next dev -p 3001 -H 127.0.0.1",
    "build": "next build --turbopack",
    "start": "next start -p 3001 -H 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "atalho": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-shortcut.ps1",
    "setup-electron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-electron.ps1",
    "sync-packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-packaged.ps1 -Launch",
    "dist": "node scripts/prepare-dist.mjs && cd release-staging && npx electron-builder --win nsis"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/pdfkit": "^0.17.7",
    "baileys": "^7.0.0-rc14",
    "diff": "^8.0.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.15.0",
    "groq-sdk": "^0.9.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.4",
    "mp4-muxer": "^5.2.1",
    "next": "15.5.29",
    "openai": "^4.77.0",
    "pdfkit": "^0.20.2",
    "playwright": "^1.65.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "sonner": "^1.7.2",
    "uuid": "^11.0.3",
    "ws": "^8.23.0"
  },
  "build": {
    "appId": "com.jarvis.ai",
    "productName": "JARVIS AI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "next.config.ts",
      "tsconfig.json",
      "next-env.d.ts",
      ".next/**/*",
      "data/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.2",
    "vitest": "^4.1.12"
  }
}
